#!/usr/bin/env argivo
# shellcheck shell=bash

# @desc User management example
function main() {
    argivo::error "no command provided"
}

# @desc Create a user
# @param username Username
# @param age type=number default=18 User age
# @param admin type=boolean optional Admin privileges
function create_user() {
    local username="$1"
    local age="$2"
    local admin="${3:-}"

    validate_username "$username" || return 1
    _save_user "$username"

    echo "User '$1' created"
    echo "Username: $username"
    echo "Age: $age"

    if [[ -n "$admin" ]]; then
        echo "Admin: $admin"
    else
        echo "Admin: false"
    fi
}

# @hidden
# @desc Validate username
function validate_username() {
    if [[ -z "$1" ]]; then
        echo "invalid username"
        return 1
    fi

    return 0
}

# @desc Save user in database
function _save_user() {
    echo "(saving '$1' in database)"
}