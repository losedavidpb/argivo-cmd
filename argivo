#!/usr/bin/env bash
#
# argivo - interpreter for argivo scripts

set -Eeuo pipefail

# Directories for argivo libraries
_argivo_lib="/usr/local/lib/argivo"
_argivo_public_lib="$_argivo_lib/public"
_argivo_private_lib="$_argivo_lib/private"

# Check library directory
if [[ ! -d "$_argivo_lib" ]]; then
    echo "error: library directory not found: $_argivo_lib" >&2
    exit 1
fi

# Check public library directory
if [[ ! -d "$_argivo_public_lib" ]]; then
    echo "error: public library directory not found: $_argivo_public_lib" >&2
    exit 1
fi

# Check private library directory
if [[ ! -d "$_argivo_private_lib" ]]; then
    echo "error: private library directory not found: $_argivo_private_lib" >&2
    exit 1
fi

# Load public libraries
for _lib in "$_argivo_public_lib"/*.bash; do
    if [[ -f "$_lib" && -r "$_lib" ]]; then
        # shellcheck source=/dev/null
        source "$_lib"
    else
        echo "error: $_lib not found or not readable" >&2
        exit 1
    fi
done

# Check whether the user provided arguments
if (($# == 0)); then
    # shellcheck source=/dev/null
    source "$_argivo_private_lib/metadata.bash"
    _argivo::help
    exit 0
fi

# The interpreter includes built-in commands
# that can be used without a user script
case "$1" in
    --version|-v)
        # shellcheck source=/dev/null
        source "$_argivo_private_lib/metadata.bash"
        _argivo::version
        exit 0
    ;;

    --about|-a)
        # shellcheck source=/dev/null
        source "$_argivo_private_lib/metadata.bash"
        _argivo::about
        exit 0
    ;;

    --help|-h)
        # shellcheck source=/dev/null
        source "$_argivo_private_lib/metadata.bash"
        _argivo::help
        exit 0
    ;;

    --check|-c)
        # Check that there are enough parameters
        if (($# < 2 )); then
            echo "error: the script to be checked is not defined"
            exit 1
        fi

        shift

        # Get the script to be interpreted
        _script="$1"
        shift

        # Check that the script exists
        if [[ ! -f "$_script" ]]; then
            echo "error: script not found: $_script"
            exit 1
        fi

        # shellcheck source=/dev/null
        source "$_argivo_private_lib/syntax.bash"

        # shellcheck source=/dev/null
        source "$_argivo_private_lib/parser.bash"

        # Parse script before checking the script
        _argivo::parse_script

        # shellcheck source=/dev/null
        source "$_argivo_private_lib/metadata.bash"

        # shellcheck source=/dev/null
        source "$_argivo_private_lib/checker.bash"

        # Check that the script is a valid argivo script
        _argivo::check "$_script" --verbose
        exit 0
    ;;
esac

# Get the script to be interpreted
_script="$1"
shift

# The script must exist and be readable
if [[ ! -f "$_script" || ! -r "$_script" ]]; then
    echo "error: script not found or is not readable"
    return 1
fi

# shellcheck source=/dev/null
source "$_argivo_private_lib/syntax.bash"

# shellcheck source=/dev/null
source "$_argivo_private_lib/parser.bash"

# Parse script before checking the script
_argivo::parse_script

# shellcheck source=/dev/null
source "$_argivo_private_lib/metadata.bash"

# shellcheck source=/dev/null
source "$_argivo_private_lib/checker.bash"

# Run the check when the @argivo check directive is missing,
# set to "true", or has any value other than "false"
if [[ ! -v _ARGIVO_DIRECTIVES["check"] || "${_ARGIVO_DIRECTIVES["check"]}" == "true" ]]; then
    if ! _argivo::check "$_script"; then
        exit 1
    fi
fi

# Load the script the user wants to run
# shellcheck source=/dev/null
source "$_script"

# Temporal variables to save commands, arguments
# and exclusions before executing the script
declare -A _executed_exclusions=()
declare -a _planned_commands=()
declare -a _planned_argc=()
declare -a _planned_args=()

# If no command is provided, execute main if it exists
if (($# == 0)); then
    if declare -F main >/dev/null; then
        set -- --main
    else
        echo "error: no command provided"
        exit 1
    fi
fi

# Process the command-line arguments to determine
# which command to execute
while (($# > 0)); do
    # If the first argument is not a command,
    # treat it as arguments for main
    if [[ ! "$1" =~ ^- ]]; then
        if declare -F main >/dev/null; then
            _cmd="main"
        else
            echo "error: unexpected argument: $1"
            exit 1
        fi
    else

        # Commands must be specified with a leading "-" or "--"
        if [[ ! "$1" =~ ^--?[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
            echo "error: invalid command syntax: $1"
            exit 1
        fi

        # Raw command to be executed
        _raw_cmd="$1"
        shift

        # Command is specified with "--", so we remove the
        # leading dashes to get the command name
        if [[ "$_raw_cmd" == --* ]]; then
            _cmd="${_raw_cmd#--}"

            # Built-in help command for user-defined commands
            if [[ "$_cmd" == "help" ]]; then
                # shellcheck source=/dev/null
                source "$_argivo_private_lib/helper.bash"

                _argivo::help_script "$@"
                exit 0
            fi

        # Command is specified with "-", so we treat it as an alias
        # in case it matches one of the defined aliases
        elif [[ "$_raw_cmd" == -* ]]; then
            _alias_name="${_raw_cmd#-}"

            # Built-in help command for user-defined commands
            if [[ "$_alias_name" == "h" ]]; then
                # shellcheck source=/dev/null
                source "$_argivo_private_lib/helper.bash"

                _argivo::help_script "$@"
                exit 0
            fi

            if [[ -n "${_ARGIVO_ALIASES[$_alias_name]:-}" ]]; then
                _cmd="${_ARGIVO_ALIASES[$_alias_name]}"
            else
                echo "error: unknown command alias: $_alias_name"
                exit 1
            fi
        fi
    fi

    # Check that the command exists
    if ! declare -F "$_cmd" >/dev/null; then
        echo "error: unknown command: $_cmd"
        exit 1
    fi

    # Hidden commands cannot be executed directly
    if [[ "${_ARGIVO_HIDDEN[$_cmd]:-false}" == "true" ]]; then
        echo "error: unknown command: $_cmd"
        exit 1
    fi

    # Private commands cannot be executed directly
    if [[ "$_cmd" == _* || "$_cmd" == argivo::* ]]; then
        echo "error: unknown command: $_cmd"
        exit 1
    fi

    _param_count=0

    # Determine how many arguments the command expects
    if [[ -n "${_ARGIVO_PARAMS[$_cmd]:-}" ]]; then
        read -r -a _params <<< "${_ARGIVO_PARAMS[$_cmd]}"
        _param_count="${#_params[@]}"
    fi

    _cmd_args=()

    # Collect the arguments for the command based on
    # the number of parameters it expects
    for ((i = 0; i < _param_count; i++)); do
        _param="${_params[$i]}"

        _key="$_cmd:$_param"

        _default="${_ARGIVO_PARAM_DEFAULTS[$_key]:-}"
        _optional="${_ARGIVO_PARAM_OPTIONAL[$_key]:-false}"

        if (($# == 0)); then
            if [[ -n "$_default" ]]; then
                _cmd_args+=("$_default")
                continue
            fi

            if [[ "$_optional" == "true" ]]; then
                _cmd_args+=("")
                continue
            fi

            # shellcheck source=/dev/null
            source "$_argivo_private_lib/helper.bash"

            echo "error: missing arguments for command: $_cmd"
            echo "usage: $(basename "$_script") $(_argivo::usage "$_cmd")"
            exit 1
        fi

        _cmd_args+=("$1")
        shift
    done

    # Check parameter types
    for ((i = 0; i < ${#_cmd_args[@]}; i++)); do
        _param="${_params[$i]}"
        _value="${_cmd_args[$i]}"
        _type="${_ARGIVO_PARAM_TYPES["$_cmd:$_param"]:-}"

        # Optional or untyped parameters may be omitted
        [[ -z "$_type" ]] && continue
        [[ -z "$_value" ]] && continue

        if ! "argivo::is_${_type}" "$_value"; then
            echo "error: parameter '$_param' must be a valid $_type"
            exit 1
        fi
    done

    # Check exclusion groups
    for _group in ${_ARGIVO_EXCLUSIONS[$_cmd]:-}; do
        if [[ -n "${_executed_exclusions[$_group]:-}" ]]; then
            echo "error: exclusion group conflict: $_group"
            exit 1
        fi

        _executed_exclusions["$_group"]=1
    done

    _planned_commands+=("$_cmd")
    _planned_argc+=("${#_cmd_args[@]}")

    for _arg in "${_cmd_args[@]}"; do
        _planned_args+=("$_arg")
    done

    # If the command is "main", check if there are
    # any unexpected arguments
    if [[ "$_cmd" == "main" ]]; then
        if (($# > 0)); then
            echo "error: unexpected argument: $1"
            exit 1
        fi

        break
    fi
done

declare -A _explicit_commands=()

for _cmd in "${_planned_commands[@]}"; do
    _explicit_commands["$_cmd"]=1
done

# Check requires groups
for ((i = 0; i < ${#_planned_commands[@]}; i++)); do
    _cmd="${_planned_commands[$i]}"

    for _required in ${_ARGIVO_REQUIRES[$_cmd]:-}; do

        # Required command was explicitly provided
        if [[ -n "${_explicit_commands[$_required]:-}" ]]; then
            _found_before=false

            for ((j = 0; j < i; j++)); do
                if [[ "${_planned_commands[$j]}" == "$_required" ]]; then
                    _found_before=true
                    break
                fi
            done

            if ! $_found_before; then
                echo "error: command '$_cmd' requires '$_required' to appear before it"
                exit 1
            fi

        # Required command was not explicitly provided
        else
            _planned_commands=("${_planned_commands[@]:0:i}" "$_required" "${_planned_commands[@]:i}")
            _planned_argc=("${_planned_argc[@]:0:i}" "0" "${_planned_argc[@]:i}")

            _explicit_commands["$_required"]=1

            i=$((i - 1))
            break
        fi
    done
done

_arg_index=0

# Execute the commands with its arguments
for ((i = 0; i < ${#_planned_commands[@]}; i++)); do
    _cmd="${_planned_commands[$i]}"
    _argc="${_planned_argc[$i]}"

    _cmd_args=()

    for ((j = 0; j < _argc; j++)); do
        _cmd_args+=("${_planned_args[$_arg_index]}")
        ((_arg_index += 1))
    done

    "$_cmd" "${_cmd_args[@]}"
done